{
  "name": "@deevo/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server adapter for DEEVO AI Studio and NoteAgents",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
